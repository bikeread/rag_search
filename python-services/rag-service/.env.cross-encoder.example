# Cross-Encoder重排序配置示例
# 复制此文件为 .env 并根据需要调整配置

# Cross-Encoder模型配置
# 轻量级模型，适合生产环境（默认推荐）
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# 更高精度的模型选项（需要更多计算资源）
# CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
# CROSS_ENCODER_MODEL=cross-encoder/ms-marco-electra-base

# 批处理大小（根据内存大小调整）
# 较小值：内存使用少，处理慢
# 较大值：内存使用多，处理快
CROSS_ENCODER_BATCH_SIZE=8

# 缓存大小（查询-文档对评分缓存）
# 较大值：缓存命中率高，内存使用多
# 较小值：缓存命中率低，内存使用少
CROSS_ENCODER_CACHE_SIZE=1000

# 其他RAG服务配置
VECTOR_SERVICE_URL=http://localhost:8002
LLM_SERVICE_URL=http://localhost:11434

# 性能调优建议：
# 1. 生产环境推荐使用 ms-marco-MiniLM-L-6-v2（延迟<200ms）
# 2. 如果有GPU，可以考虑使用更大的模型
# 3. 批处理大小建议根据并发量和内存大小调整
# 4. 缓存大小建议根据查询重复率和内存大小调整